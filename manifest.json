{
  "manifest_version": 3,
  "name": "TikTok Auto Tool",
  "version": "2.0",
  "description": "Auto accept messages & auto send on TikTok Live",
  "permissions": [
    "scripting",
    "activeTab",
    "tabs"
  ],
  "host_permissions": [
    "https://www.tiktok.com/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.tiktok.com/@hocvanchitam/live*"
      ],
      "js": [
        "content.js"
      ]
    }
  ]
}